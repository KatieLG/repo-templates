<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{project_name}}</title>
    <link href="/static/styles.css" rel="stylesheet">
</head>
{%- if include_tailwind %}
<body class="bg-gray-50 min-h-screen font-sans">
    <div class="max-w-2xl mx-auto px-6 py-12">
        <h1 class="text-3xl font-bold text-gray-900 mb-2">{{project_name}}</h1>
        <p class="text-gray-500 mb-8">{{project_description}}</p>
        <nav class="flex gap-4">
            <a href="/items" class="inline-block bg-blue-600 text-white text-sm font-medium px-4 py-2 rounded-lg hover:bg-blue-700">Items</a>
            <a href="/docs" class="inline-block bg-white border border-gray-200 text-gray-700 text-sm font-medium px-4 py-2 rounded-lg hover:bg-gray-50">API Docs</a>
        </nav>
    </div>
{%- else %}
<body>
    <h1>{{project_name}}</h1>
    <p>{{project_description}}</p>
    <nav>
        <a href="/items">Items</a> |
        <a href="/docs">API Docs</a>
    </nav>
{%- endif %}
</body>
</html>
