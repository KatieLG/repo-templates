name: Main

on:
  push:
    branches: [ "main" ]
{%- if include_publish %}
    tags: ["v*"]
{%- endif %}
  pull_request:
    branches: [ "main" ]

jobs:
  lint:
    runs-on: ubuntu-latest
    permissions:
{%- if include_format_and_push %}
      contents: write
{%- else %}
      contents: read
{%- endif %}
    steps:
      - uses: actions/checkout@v4
      - uses: astral-sh/setup-uv@v4
      - run: uv sync
{% if include_format_and_push %}
      - name: Format
        run: make format

      - name: Push any changes
        run: |
          git config --global user.name 'github-actions[bot]'
          git config --global user.email '41898282+github-actions[bot]@users.noreply.github.com'

          if [[ `git status --porcelain` ]]; then
            git add {% if project_type == 'fastapi' %}app{% else %}src{% endif %}/*
            git add tests/*
            git commit -m "chore: code formatting"
            git push
          else
            echo "No changes to commit"
          fi
{% endif %}
      - name: Lint
        run: make lint

  test:
    runs-on: ubuntu-latest
{%- if include_version_matrix %}
    strategy:
      matrix:
        python-version: ["3.10", "3.11", "3.12", "3.13"]
{%- endif %}
    permissions:
      contents: read
    steps:
      - uses: actions/checkout@v4
      - uses: astral-sh/setup-uv@v4
{%- if include_version_matrix %}
        with:
          python-version: {% raw %}${{ matrix.python-version }}{% endraw %}

{%- endif %}
      - run: uv sync
{% if project_type == 'fastapi' and include_tailwind %}
      - name: Install Tailwind CSS CLI
        run: |
          curl -sLO https://github.com/tailwindlabs/tailwindcss/releases/latest/download/tailwindcss-linux-x64
          chmod +x tailwindcss-linux-x64
          sudo mv tailwindcss-linux-x64 /usr/local/bin/tailwindcss

      - name: Build CSS
        run: make build-css
{% endif %}
      - name: Test
        run: make test
{% if include_publish %}
  release:
    needs: [lint, test]
    runs-on: ubuntu-latest
    if: startsWith(github.ref, 'refs/tags/v')
    environment: release
    permissions:
      id-token: write
      contents: read
    steps:
      - uses: actions/checkout@v4
      - uses: astral-sh/setup-uv@v4
      - run: uv build
      - uses: pypa/gh-action-pypi-publish@release/v1
{% endif %}
