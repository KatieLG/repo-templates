import logging
from functools import cache
from pathlib import Path

from pydantic import Field
from pydantic_settings import BaseSettings, SettingsConfigDict

PROJECT_DIR = Path(__file__).resolve().parents[3]

APP_TITLE = "{{ app_title }}"
DEFAULT_THEME = "{{ project_name }}"

logging.basicConfig(
    format="%(asctime)s - %(name)s - %(levelname)s - %(message)s",
    datefmt="%d-%b-%y %H:%M:%S",
    level="INFO",
)


class Settings(BaseSettings):
    """Application settings."""

    data_dir: Path = Field(default=PROJECT_DIR / "data", validation_alias="{{ env_prefix }}_DATA_DIR")
    debug: bool = Field(default=False, validation_alias="{{ env_prefix }}_DEBUG")

    model_config = SettingsConfigDict(env_file=PROJECT_DIR / ".env", extra="ignore")
{%- if include_database %}

    @property
    def db_path(self) -> Path:
        return self.data_dir / "{{ project_name }}.db"
{%- endif %}


@cache
def get_settings() -> Settings:
    """Get application settings."""

    return Settings()
