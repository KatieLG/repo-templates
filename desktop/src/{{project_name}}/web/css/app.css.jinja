[x-cloak] { display: none !important; }

[data-theme='{{ project_name }}'] {
  color-scheme: dark;
  --color-base-100: oklch(27% 0.035 255);
  --color-base-200: oklch(22% 0.03 255);
  --color-base-300: oklch(18% 0.025 255);
  --color-base-content: oklch(95% 0.01 255);
  --color-primary: oklch(74% 0.13 200);
  --color-primary-content: oklch(22% 0.04 200);
  --color-secondary: oklch(66% 0.17 285);
  --color-secondary-content: oklch(98% 0.01 285);
  --color-accent: oklch(80% 0.14 160);
  --color-accent-content: oklch(25% 0.05 160);
  --color-neutral: oklch(33% 0.035 255);
  --color-neutral-content: oklch(95% 0.01 255);
  --color-info: oklch(74% 0.14 235);
  --color-info-content: oklch(25% 0.06 235);
  --color-success: oklch(76% 0.16 155);
  --color-success-content: oklch(25% 0.06 155);
  --color-warning: oklch(82% 0.16 80);
  --color-warning-content: oklch(30% 0.08 60);
  --color-error: oklch(70% 0.18 25);
  --color-error-content: oklch(25% 0.08 25);
  --radius-selector: 1rem;
  --radius-field: 0.6rem;
  --radius-box: 1rem;
  --size-selector: 0.25rem;
  --size-field: 0.25rem;
  --border: 1px;
  --depth: 1;
  --noise: 0;
}

.brand-gradient {
  background: linear-gradient(135deg, var(--color-primary), var(--color-secondary));
}
