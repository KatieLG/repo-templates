{% from "macros.html" import icon %}
{% set tabs = [('home', 'Home', 'home')] %}
{% macro layout() %}
  <div class="h-full flex" x-show="ready" x-cloak>
    <aside class="w-60 shrink-0 flex flex-col p-4 gap-2 bg-base-100 border-r border-base-content/10">
      <div class="flex items-center gap-2 px-2 py-3 mb-2">
        <div class="rounded-xl brand-gradient p-2 text-white">{{ icon("app") }}</div>
        <span class="text-lg font-semibold tracking-tight">{{ app_title }}</span>
      </div>
      <ul class="menu w-full gap-1 p-0">
        {% for tab, label, tab_icon in tabs %}
          <li>
            <button type="button"
                    class="rounded-xl py-2.5"
                    :class="tab === '{{ tab }}' && 'menu-active'"
                    @click="tab = '{{ tab }}'">
              {{ icon(tab_icon) }}
              {{ label }}
            </button>
          </li>
        {% endfor %}
      </ul>
      <div class="mt-auto flex flex-col gap-3 px-1">
        {# :selected rather than :value, as Alpine can set the value before the options exist #}
        <select class="select select-sm" x-model="theme" aria-label="Theme">
          <template x-for="t in themes" :key="t">
            <option :value="t" x-text="t" :selected="t === theme"></option>
          </template>
        </select>
      </div>
    </aside>
    <main class="flex-1 overflow-y-auto">
      {{ caller() }}
    </main>
  </div>
{% endmacro %}
