"""
User preferences, stored in <data_dir>/prefs.json.

localStorage doesn't work for this: pywebview serves the page on a different port each launch.
"""

import json
import logging
from pathlib import Path

from {{ project_name }}.config.settings import get_settings

logger = logging.getLogger(__name__)


def _path() -> Path:
    return get_settings().data_dir / "prefs.json"


def load() -> dict[str, object]:
    """All stored preferences. A missing or unreadable file counts as empty."""
    path = _path()
    try:
        data = json.loads(path.read_text())
    except FileNotFoundError:
        return {}
    except (OSError, ValueError):
        logger.warning("Ignoring unreadable preferences file %s", path)
        return {}
    return data if isinstance(data, dict) else {}


def get(key: str, default: object = None) -> object:
    return load().get(key, default)


def save(key: str, value: object) -> None:
    """Stores one JSON-serialisable preference."""
    data = load()
    data[key] = value
    path = _path()
    path.parent.mkdir(parents=True, exist_ok=True)
    # Write then rename, so a crash mid-write can't leave a half-written file
    tmp = path.with_suffix(".tmp")
    tmp.write_text(json.dumps(data, indent=2, sort_keys=True))
    tmp.replace(path)


def reset() -> None:
    """Forgets every preference."""
    _path().unlink(missing_ok=True)
