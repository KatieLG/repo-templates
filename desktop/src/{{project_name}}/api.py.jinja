"""
Methods exposed to JavaScript as window.pywebview.api.<name>. Raising ValueError shows the
message to the user as an error toast.

Don't import webview at the top of this module, so tests can import it without a display.
"""

from typing import TYPE_CHECKING, Any

from {{ project_name }} import prefs

if TYPE_CHECKING:
    import webview

PREF_KEYS = ("theme",)


class Api:
    def __init__(self) -> None:
        self._window: webview.Window | None = None

    def _attach(self, window: "webview.Window") -> None:
        self._window = window

    def get_prefs(self) -> dict[str, Any]:
        stored = prefs.load()
        return {key: stored.get(key) for key in PREF_KEYS}

    def set_pref(self, key: str, value: str | float | bool | None) -> None:
        if key not in PREF_KEYS:
            raise ValueError(f"Unknown preference: {key}")
        prefs.save(key, value)
