]

{% include 'shared/pyproject/build-system.toml' %}
[dependency-groups]
dev = [
    "djlint>=1.50.1",
    "pytest>=9.0.3",
    "ruff>=0.15.13",
    "ty>=0.0.37",
]

{% include 'shared/pyproject/ruff.toml' %}
lint.allowed-confusables = ["–"]

[tool.djlint]
profile = "jinja"
indent = 2
