from pathlib import Path

import pytest

from {{ project_name }} import db


@pytest.fixture
def path(tmp_path: Path) -> Path:
    path = tmp_path / "test.db"
    db.init(path)
    with db.connect(path) as conn:
        conn.execute("CREATE TABLE things (name TEXT)")
    return path


def count(path: Path) -> int:
    with db.connect(path) as conn:
        return conn.execute("SELECT COUNT(*) FROM things").fetchone()[0]


def test_init_records_the_schema_version(path: Path) -> None:
    with db.connect(path) as conn:
        assert conn.execute("PRAGMA user_version").fetchone()[0] == db.SCHEMA_VERSION


def test_connect_commits_on_success(path: Path) -> None:
    with db.connect(path) as conn:
        conn.execute("INSERT INTO things VALUES ('kept')")
    assert count(path) == 1


def test_connect_rolls_back_on_error(path: Path) -> None:
    with pytest.raises(RuntimeError), db.connect(path) as conn:
        conn.execute("INSERT INTO things VALUES ('lost')")
        raise RuntimeError
    assert count(path) == 0
